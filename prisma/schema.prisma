// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShopProfile {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  name                 String
  email                String   @unique
  phone                String?
  address              String?
  currencySymbol       String   @default("₹") @map("currency_symbol")
  receiptFooterMessage String?  @default("Thank you for your business!") @map("receipt_footer_message")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("shop_profile")
}

model Product {
  id                      String   @id @default(uuid())
  productId               String   @unique @map("product_id") // Permanent Business ID e.g. HW-0001
  name                    String
  size                    String   @default("") // Flexible text: e.g. "1.5 inch", "4 inch"
  companyBrand            String   @default("") @map("company_brand")
  unit                    String   @default("Pcs") // "Pieces", "Nos", "Meters", "Kg", etc.
  stockQuantity           Decimal  @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  lowStockLimit           Decimal  @default(5) @map("low_stock_limit") @db.Decimal(12, 3)
  mrp                     Decimal  @default(0) @db.Decimal(12, 2)
  purchaseDiscountPercent Decimal  @default(0) @map("purchase_discount_percent") @db.Decimal(5, 2)
  purchasePrice           Decimal  @default(0) @map("purchase_price") @db.Decimal(12, 2)
  profitMarginPercent     Decimal  @default(0) @map("profit_margin_percent") @db.Decimal(5, 2)
  sellingPrice            Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  previousSellingPrice    Decimal? @map("previous_selling_price") @db.Decimal(12, 2)
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  priceHistory      PriceHistory[]
  stockTransactions StockTransaction[]
  invoiceItems      InvoiceItem[]
  customFieldValues CustomFieldValue[]

  @@index([productId])
  @@index([name])
  @@index([companyBrand])
  @@index([isActive])
  @@map("products")
}

model PriceHistory {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  oldSellingPrice  Decimal? @map("old_selling_price") @db.Decimal(12, 2)
  newSellingPrice  Decimal  @map("new_selling_price") @db.Decimal(12, 2)
  oldPurchasePrice Decimal? @map("old_purchase_price") @db.Decimal(12, 2)
  newPurchasePrice Decimal  @map("new_purchase_price") @db.Decimal(12, 2)
  changeReason     String?  @map("change_reason")
  changedBy        String   @default("Owner") @map("changed_by")
  changedAt        DateTime @default(now()) @map("changed_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("price_history")
}

model StockTransaction {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  transactionType String   @map("transaction_type") // STOCK_RECEIVED, SALE, RETURN, ADJUSTMENT, IMPORT_SET
  quantityChange  Decimal  @map("quantity_change") @db.Decimal(12, 3)
  stockBefore     Decimal  @map("stock_before") @db.Decimal(12, 3)
  stockAfter      Decimal  @map("stock_after") @db.Decimal(12, 3)
  referenceId     String?  @map("reference_id")
  referenceType   String?  @map("reference_type") // INVOICE, MANUAL, IMPORT, RETURN
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("stock_transactions")
}

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique @map("invoice_number") // e.g. INV-000001
  billDate       DateTime @default(now()) @map("bill_date")
  customerName   String?  @map("customer_name")
  customerPhone  String?  @map("customer_phone")
  paymentMode    String   @default("CASH") @map("payment_mode") // CASH, UPI
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalTotal     Decimal  @default(0) @map("final_total") @db.Decimal(12, 2)
  status         String   @default("COMPLETED") // COMPLETED, EDITED, CANCELLED
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  items   InvoiceItem[]
  returns InvoiceReturn[]

  @@index([invoiceNumber])
  @@index([billDate])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id                   String  @id @default(uuid())
  invoiceId            String  @map("invoice_id")
  productId            String  @map("product_id")
  productIdSnapshot    String  @map("product_id_snapshot") // Immutable historical code e.g. HW-0001
  productNameSnapshot  String  @map("product_name_snapshot")
  sizeSnapshot         String  @default("") @map("size_snapshot")
  unitSnapshot         String  @default("Pcs") @map("unit_snapshot")
  sellingPriceSnapshot Decimal @map("selling_price_snapshot") @db.Decimal(12, 2)
  purchaseCostSnapshot Decimal @default(0) @map("purchase_cost_snapshot") @db.Decimal(12, 2)
  quantity             Decimal @db.Decimal(12, 3)
  lineTotal            Decimal @map("line_total") @db.Decimal(12, 2)

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model InvoiceReturn {
  id                  String   @id @default(uuid())
  invoiceId           String   @map("invoice_id")
  returnNumber        String   @unique @map("return_number") // RET-000001
  totalReturnedAmount Decimal  @map("total_returned_amount") @db.Decimal(12, 2)
  reason              String?
  createdAt           DateTime @default(now()) @map("created_at")

  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  items   ReturnItem[]

  @@index([invoiceId])
  @@map("invoice_returns")
}

model ReturnItem {
  id                  String  @id @default(uuid())
  returnId            String  @map("return_id")
  invoiceItemId       String  @map("invoice_item_id")
  productId           String  @map("product_id")
  productNameSnapshot String  @map("product_name_snapshot")
  quantity            Decimal @db.Decimal(12, 3)
  unitPriceSnapshot   Decimal @map("unit_price_snapshot") @db.Decimal(12, 2)
  refundAmount        Decimal @map("refund_amount") @db.Decimal(12, 2)

  invoiceReturn InvoiceReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceItem   InvoiceItem   @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([invoiceItemId])
  @@map("return_items")
}

model CustomFieldDefinition {
  id           String   @id @default(uuid())
  fieldKey     String   @unique @map("field_key")
  label        String
  dataType     String   @default("TEXT") @map("data_type") // TEXT, NUMBER, DATE, BOOLEAN
  isRequired   Boolean  @default(false) @map("is_required")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  values CustomFieldValue[]

  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                String   @id @default(uuid())
  productId         String   @map("product_id")
  fieldDefinitionId String   @map("field_definition_id")
  fieldValue        String   @map("field_value")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([productId, fieldDefinitionId])
  @@index([productId])
  @@map("custom_field_values")
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  entityName     String   @map("entity_name")
  entityId       String   @map("entity_id")
  changesSummary String?  @map("changes_summary")
  performedBy    String   @default("Owner") @map("performed_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityName, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("OWNER") // OWNER, ADMIN, STAFF
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model SequenceCounter {
  name         String   @id // e.g. "INVOICE", "RETURN"
  currentValue Int      @default(0) @map("current_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sequence_counters")
}

