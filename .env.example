# TradeStock Pro Environment Variables Configuration

# Session & Security
# 32+ character random string for signing JWT tokens and cookies
SESSION_SECRET=tradestock-pro-super-secure-production-secret-key-32-chars-min

# Database Configuration
# In single-shop / local mode, atomic JSON repository in .tradestock-data is active.
# To connect to a live PostgreSQL / Supabase / Google Cloud SQL instance:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?schema=public

# Platform Database (For Phase B Multi-Shop Cloud SQL Routing)
# PLATFORM_DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/tradestock_platform?schema=public

# Storage Provider (local | gcs)
STORAGE_BACKEND=local
# For Google Cloud Storage in production:
# GCS_BUCKET_NAME=tradestock-invoices-prod
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Server Port
PORT=3000
